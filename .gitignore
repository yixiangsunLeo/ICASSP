# ===== raw data: NEVER in this repo (external, path from configs/paths.yaml) =====
/data/

# ===== run artifacts (processed npz lives under outputs/processed — stay out) =====
# Default-deny, then re-include only small text results so 3090 ↔ 4090 can sync
# via GitHub. Binary rules (*.pt *.npz) later in this file win over these negations.
/outputs/*
!/outputs/.gitkeep
!/outputs/analysis/
!/outputs/experiments/
/outputs/experiments/**
!/outputs/experiments/**/
!/outputs/experiments/**/result.json
!/outputs/experiments/**/failures__*.json
!/outputs/experiments/**/resolved_config__*.yaml
!/outputs/experiments/**/resolved_model_params__*.json
!/outputs/experiments/**/meta_cross_subject__*.json
!/outputs/experiments/**/cross_subject_folds__*.json
/outputs/experiments/_smoke/**
/outputs/analysis/**
!/outputs/analysis/**/
!/outputs/analysis/**/*.csv
!/outputs/analysis/**/*.md
/logs/*
/checkpoints/*
!/logs/.gitkeep
!/checkpoints/.gitkeep
wandb/
runs/
slog/

# ===== pretrained weights (LaBraM / EEGPT / CBraMod) — never in git =====
# 4090: this path is a symlink to ../Benchmark/weights. 3090: make a real dir
# and copy the three files (sha256 in code/models/external/README.md / HANDOFF.md).
/weights
/weights/*

# ===== ANN bench snapshot: README + tables + cells/*/result.json (for --bench) =====
# predictions.npz and curve PNGs stay on disk (*.npz / later rules).
/results_snapshot_*/*
!/results_snapshot_*/README.md
!/results_snapshot_*/experiments/
!/results_snapshot_*/experiments/*/
!/results_snapshot_*/experiments/*/*/
/results_snapshot_*/experiments/*/*/*
!/results_snapshot_*/experiments/*/*/tables/
!/results_snapshot_*/experiments/*/*/tables/**
!/results_snapshot_*/experiments/*/*/cells/
/results_snapshot_*/experiments/*/*/cells/**
!/results_snapshot_*/experiments/*/*/cells/*/
!/results_snapshot_*/experiments/*/*/cells/*/result.json

# senior's WeChat screenshots (docs/history/assets): keep on disk, never push
/docs/history/assets/*.png

# ===== generated manifests & splits (contain absolute server paths) =====
/manifests/*.csv
/manifests/*.json
/splits/*.json

# keep the directory structure (re-include placeholder files)
!**/.gitkeep

# ===== python =====
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ===== env =====
.env
.venv/
env/
venv/

# ===== large / binary data files (anywhere) =====
*.bdf
*.edf
*.mat
*.npy
*.npz
*.pt
*.pth
*.ckpt
*.h5
*.hdf5
*.rar
*.zip
*.tar
*.tar.gz
*.7z
*.pdf
*.pptx
*.ppt

# ===== editor / OS / IDE local =====
.DS_Store
*.swp
.idea/
*.local.yaml
*.local.yml

# ===== slurm / job noise =====
*.out
*.err

# ===== paper (ICASSP 2027): keep sources, official kit PDFs + vector figures, drop build artefacts =====
!/paper/figures/*.pdf
!/paper/official_kit/*.pdf
/paper/main.pdf
/paper/*.aux
/paper/*.bbl
/paper/*.blg
/paper/*.log
/paper/*.out
/paper/*.fls
/paper/*.fdb_latexmk
/paper/*.synctex.gz
